# ─── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Prod:
# NEXTAUTH_URL=https://www.aspectmarketingsolutions.app

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Shopify (TeesandTruma store) ───────────────────────────────────────────
# Your Shopify .myshopify.com domain, e.g. teesandtruma.myshopify.com
SHOPIFY_SHOP_DOMAIN=

# Admin API access token (never commit a real value)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Webhook HMAC secret – copy from Shopify Partners > Webhooks
SHOPIFY_WEBHOOK_SECRET=

# Optional: Storefront API token (read-only, safe for server-side fetches)
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─── Redis / Entitlements storage ───────────────────────────────────────────
# Option A: Vercel KV (auto-injected when you connect a KV store in Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Option B: Upstash Redis direct (use if not on Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── OpenRouter (server-side AI inference) ────────────────────────────────────
# Required: your OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: primary model slug (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Optional: comma-separated fallback models tried in order if primary fails
# e.g. anthropic/claude-3-haiku,google/gemma-2-9b-it:free
OPENROUTER_FALLBACK_MODELS=

# Optional: sent as HTTP-Referer header (attribution in OpenRouter dashboard)
OPENROUTER_SITE_URL=

# Optional: sent as X-Title header (your app name in OpenRouter dashboard)
OPENROUTER_APP_NAME=
